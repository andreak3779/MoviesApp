ANGULAR_CLIENT_PORT=4000
MVC_WEB_PORT=8080
WEB_API_PORT=8081

# The MVC app's API base address. It must end in /api/v1 - the MVC app
# refuses to start otherwise.
MOVIES_API_BASE_URL=http://web-api:8080/api/v1

# The API's JWT signing key. The API refuses to start while its configured
# key is still the placeholder that ships in appsettings.json, so this value
# is required by docker compose.
#
# Generate one with: openssl rand -base64 48
# Never commit a real key - .env is git-ignored.
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS_IN_PRODUCTION

# The browser origins allowed to call the API with credentials. The list
# binds from indexed variables, so add API_ALLOWED_ORIGIN_2, _3, ... for
# more origins.
API_ALLOWED_ORIGIN_0=http://localhost:4000
API_ALLOWED_ORIGIN_1=http://localhost:8080

# Serve the Swagger UI at /swagger. It is off by default outside the
# Development environment; the container stack turns it on.
ENABLE_SWAGGER=true
