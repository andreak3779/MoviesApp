<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoviesApiDomain\MoviesApiDomain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <!--
      Microsoft.Data.Sqlite pulls SQLitePCLRaw.lib.e_sqlite3 in transitively; 2.1.11 bundles a
      SQLite build that is affected by GHSA-2m69-gcr7-jv3q (NU1903, high severity). Pin the native
      package to the 3.0.x line so a patched SQLite is used instead of the vulnerable 2.1.11 one.
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.0.*" />
  </ItemGroup>

</Project>
