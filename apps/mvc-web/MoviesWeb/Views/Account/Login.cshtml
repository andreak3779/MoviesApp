@model MoviesWeb.Models.LoginRequest
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<div class="login-card">
    <h1>Sign in</h1>
    <p class="hint">Use the email and password you registered with the Movies API.</p>

    @if (!string.IsNullOrEmpty(ViewData["Error"] as string))
    {
        <p class="error">@ViewData["Error"]</p>
    }

    <form method="post" asp-controller="Account" asp-action="Login">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div asp-validation-summary="ModelOnly"></div>

        <label asp-for="Email">
            Email
            <input asp-for="Email" type="email" autocomplete="username" />
        </label>
        <span asp-validation-for="Email" class="field-error"></span>

        <label asp-for="Password">
            Password
            <input asp-for="Password" type="password" autocomplete="current-password" />
        </label>
        <span asp-validation-for="Password" class="field-error"></span>

        <button type="submit" class="btn">Sign in</button>
    </form>

    <p class="hint">
        No account yet?
        <a asp-controller="Account" asp-action="Register">Create one</a>.
    </p>
</div>
