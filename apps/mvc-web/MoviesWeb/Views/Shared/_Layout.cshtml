@{
    // The nav entry that matches the current request, so the shell can mark it.
    var path = Context.Request.Path.Value ?? string.Empty;
    string ActiveFor(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MoviesApp</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="shell">
        <aside>
            <div class="brand">MoviesApp</div>

            @* The mockup's sidebar also carries Genres, Media Types and Formats.
               Those screens are out of scope for this app, so the shell lists
               the movies collection only. *@
            <a class="nav-link @ActiveFor("/Movies")" asp-controller="Movies" asp-action="Index">Movies</a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form method="post" asp-controller="Account" asp-action="Logout" class="nav-form">
                    <button type="submit" class="nav-link">Sign out</button>
                </form>
            }
        </aside>

        <main>
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
