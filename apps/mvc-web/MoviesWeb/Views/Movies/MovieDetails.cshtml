@model MoviesWeb.Models.Movie
@{
    ViewData["Title"] = "Movie Details";
}

<div class="detail-shell">
    <a class="back" asp-controller="Movies" asp-action="Index">&larr; Back to Movies</a>

    <div class="detail-header">
        <div class="tile" style="background:@MoviesWeb.ViewModels.MovieTile.Color(Model.Id)">@MoviesWeb.ViewModels.MovieTile.Letter(Model.Title)</div>
        <div>
            <h1>@Model.Title</h1>
            <div class="year">@Model.ReleaseYear</div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="description">@Model.Description</p>
    }

    <div class="badges">
        @if (!string.IsNullOrWhiteSpace(Model.Genre))
        {
            <span class="badge">@Model.Genre</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.MediaType))
        {
            <span class="badge">@Model.MediaType</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Format))
        {
            <span class="badge">@Model.Format</span>
        }
        @if (Model.Criterion)
        {
            <span class="criterion-badge">CRITERION #@Model.CriterionNumber</span>
        }
        @if (Model.Favourite)
        {
            <span class="badge favourite">★ Favourite</span>
        }
    </div>

    <section class="section">
        <h2 class="section-title">Details</h2>
        <dl class="detail-list">
            <dt>Release year</dt>
            <dd>@Model.ReleaseYear</dd>

            <dt>Genre</dt>
            <dd>@(Model.Genre ?? "—")</dd>

            <dt>Media type</dt>
            <dd>@(Model.MediaType ?? "—")</dd>

            <dt>Format</dt>
            <dd>@(Model.Format ?? "—")</dd>

            @if (Model.Criterion)
            {
                <dt>Criterion number</dt>
                <dd>@Model.CriterionNumber</dd>
            }

            @if (Model.Favourite)
            {
                <dt>Favourite</dt>
                <dd>★ Yes</dd>
            }

            <dt>Added</dt>
            <dd>@Model.CreatedAt.ToString("d MMMM yyyy")</dd>
        </dl>
    </section>

    <div class="form-actions">
        <a class="btn secondary" asp-controller="Movies" asp-action="Index">Back</a>
        <a class="btn" asp-controller="Movies" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    </div>
</div>
